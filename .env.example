# Copia questo file in .env se vuoi usare docker-compose con chiavi reali.
# Non mettere .env su git: contiene segreti locali.

CLEARWAVE_PORT=3000
CLEARWAVE_ADMIN_PASSWORD=admin123
CLEARWAVE_ENABLE_DEMOS=0
CLEARWAVE_AUTO_EXPAND=0
CLEARWAVE_DOCKER_PRIVILEGED=false
# Se 1, il container prova a scaricare yt-dlp latest ad ogni avvio e aggira la cache Docker.
CLEARWAVE_UPDATE_YTDLP_ON_START=1
# Check automatico del catalogo: abilita solo quando vuoi generare report periodici in data/reports.
CLEARWAVE_AUDIO_CHECK_ENABLED=0
CLEARWAVE_AUDIO_CHECK_ON_START=1
CLEARWAVE_AUDIO_CHECK_MODE=probe
CLEARWAVE_AUDIO_CHECK_INTERVAL_HOURS=24
CLEARWAVE_AUDIO_CHECK_CONCURRENCY=2
CLEARWAVE_AUDIO_CHECK_TIMEOUT_MS=30000
CLEARWAVE_AUDIO_CHECK_SAMPLE_SECONDS=6
CLEARWAVE_AUDIO_CHECK_ONLY_ERRORS=1

# Player server-side per Raspberry Pi (audio via ALSA)
CLEARWAVE_SERVER_PLAYER=1
CLEARWAVE_PLAYER_COMMAND=mpv
CLEARWAVE_SERVER_VOLUME=75
# Gain Raspberry: 55 in UI diventa circa 63 in mpv. Abbassa a 1.0 se l'audio e' gia' forte.
CLEARWAVE_SERVER_VOLUME_GAIN=1.15
CLEARWAVE_SERVER_VOLUME_MAX=130
# Lascia ALSA come output predefinito; cambia solo se sai di dover usare un altro backend audio.
CLEARWAVE_AUDIO_OUTPUT=alsa
# Il backend fa un probe silenzioso dei device ALSA e passa al fallback se uno fallisce.
CLEARWAVE_AUDIO_PREFLIGHT=1
# Device mpv completo opzionale. Preferisci sysdefault/default; plughw puo' fallire se il device e' occupato.
# Esempi: alsa/sysdefault:CARD=1 oppure alsa/default
# CLEARWAVE_AUDIO_DEVICE=
# Lascia vuoto per usare ALSA default. Imposta 0/1 solo dopo aver controllato aplay -l sul Raspberry.
# ALSA_CARD=
# YouTube server-side: tieni audio-only, cosi' mpv sul Raspberry non prova formati video non disponibili.
CLEARWAVE_YTDL_PATH=/usr/bin/yt-dlp
CLEARWAVE_YTDL_FORMAT=bestaudio[acodec!=none]/bestaudio/best[acodec!=none]/best
# Runtime JavaScript per yt-dlp: riduce i KO YouTube da signature/anti-bot.
CLEARWAVE_YTDL_JS_RUNTIME=deno:/usr/local/bin/deno
# Opzionale: cookie YouTube Netscape esportati da un account autorizzato.
# Default automatico Docker: data/youtube-cookies.txt -> /app/data/youtube-cookies.txt.
# Puoi caricarlo dal pannello Admin oppure impostare un percorso diverso qui sotto.
# CLEARWAVE_YTDL_COOKIES_FILE=/app/data/youtube-cookies.txt
# Log mpv: ytdl_hook=info mostra quale sorgente YouTube viene risolta senza sommergere i log.
CLEARWAVE_MPV_MSG_LEVEL=all=warn,ytdl_hook=info
# Massimo di tracce YouTube/login ricontrollate dal pulsante admin in un giro.
CLEARWAVE_YOUTUBE_LOGIN_RECHECK_LIMIT=80
# Audit completo YouTube dal pannello Admin: lavora in background su tutto il catalogo.
CLEARWAVE_YOUTUBE_FULL_AUDIT_MODE=metadata
CLEARWAVE_YOUTUBE_FULL_AUDIT_CONCURRENCY=3
CLEARWAVE_YOUTUBE_FULL_AUDIT_TIMEOUT_MS=25000
CLEARWAVE_YOUTUBE_FULL_AUDIT_SAMPLE_SECONDS=4
# 0 = nessun limite; usa un numero piccolo solo per test rapidi.
CLEARWAVE_YOUTUBE_FULL_AUDIT_LIMIT=0

JAMENDO_CLIENT_ID=
YOUTUBE_API_KEY=
AUDIUS_API_KEY=
THEAUDIODB_API_KEY=

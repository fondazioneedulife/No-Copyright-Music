{
  "manifest_version": 3,
  "name": "ClearWave Sync",
  "version": "1.0",
  "description": "Sincronizza automaticamente i cookie di YouTube con il tuo server ClearWave.",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClearWave Sync"
  },
  "background": {
    "service_worker": "background.js"
  }
}
